# Required for live analysis. Create a key in the YouCam API console.
# Format: opaque bearer API key. Keep this file blank and put the secret in .env.
YOUCAM_API_KEY=

# Optional local web port. Integer 1–65535. Defaults to 3000.
PORT=3000

# Optional bind address. Keep 127.0.0.1 for local use; containers use 0.0.0.0.
HOST=127.0.0.1

# Set true only when served over HTTPS; keeps the session cookie Secure.
COOKIE_SECURE=false

